      "style": "Normal"
    },
    {
      "para_index": 7,
      "text": "\u5173\u8054\u5e73\u53f0\uff1a\u6807\u51c6\u5e93\u3001\u65fa\u5e97\u901a\u3001ERP\u3001WMS\u53ca\u7269\u6d41\u670d\u52a1",
