      "start": 2958.68,
      "end": 2960.58,
      "text": "对啊那他那他是他自己"
    },
    {
      "start": 2961.18,
      "end": 2962.08,
      "text": "他在发票开给我们"
    },
    {
      "start": 2962.08,
      "end": 2963.68,
      "text": "他现在那个要我们"
    },
    {
      "start": 2963.98,
      "end": 2964.58,
      "text": "我说给他"
    },
    {
      "start": 2964.68,
      "end": 2965.98,
      "text": "他跳都有的对"
    },
    {
      "start": 2966.88,
      "end": 2968.58,
      "text": "反正他们之前我们都要开他"
    },
    {
      "start": 2968.68,
      "end": 2969.38,
      "text": "开出来跳吧"
    },
    {
      "start": 2969.48,
      "end": 2970.58,
      "text": "那现在他只是跌付"
    },
    {
      "start": 2970.58,
      "end": 2972.08,
      "text": "没有转的话他说"
    },
    {
      "start": 2972.18,
      "end": 2973.58,
      "text": "这个税金要你付"
    },
    {
      "start": 2973.98,
      "end": 2975.68,
      "text": "那不是我把他做啥子我吗"
    },
    {
      "start": 2976.48,
      "end": 2977.58,
      "text": "不上当他跌什么"
    },
    {
      "start": 2978.48,
      "end": 2979.68,
      "text": "对理论上是"
    },
    {
      "start": 2979.98,
      "end": 2982.38,
      "text": "他他觉得这个钱他们跌了"
    },
    {
      "start": 2983.48,
      "end": 2983.98,
      "text": "嗯"
    },
    {
      "start": 2985.58,
      "end": 2985.98,
      "text": "是"
    },
    {
      "start": 2988.28,
      "end": 2989.88,
      "text": "你做个干嘛要你"
    },
    {
      "start": 2990.38,
      "end": 2991.68,
      "text": "对光的嗯"
    },
    {
      "start": 2992.78,
      "end": 2993.88,
      "text": "你回过也可以"
    },
    {
      "start": 2993.88,
      "end": 2995.88,
      "text": "才能就上一个一个点"
    },
    {
      "start": 2996.08,
      "end": 2997.38,
      "text": "就都是都是一个点"
    },
    {
      "start": 2997.58,
      "end": 2999.38,
      "text": "你啊六个点七个点"
    },
    {
      "start": 2999.38,
      "end": 3000.38,
      "text": "七个点他说六个点"
    },
    {
      "start": 3000.38,
      "end": 3001.58,
      "text": "出来票还可以挺挺"
