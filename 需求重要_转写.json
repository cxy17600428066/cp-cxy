    },
    {
      "start": 2806.38,
      "end": 2807.78,
      "text": "所以其他的就是机场上"
    },
    {
      "start": 2807.88,
      "end": 2809.18,
      "text": "跟业务员自己去找的"
    },
    {
      "start": 2810.38,
      "end": 2811.48,
      "text": "没有没有第三方"
    },
    {
      "start": 2811.68,
      "end": 2813.68,
      "text": "现在他只针对可以搭客这边"
    },
    {
      "start": 2813.98,
      "end": 2814.68,
      "text": "其他都没有"
    },
    {
      "start": 2817.38,
      "end": 2817.98,
      "text": "对对对"
    },
    {
      "start": 2817.98,
      "end": 2819.08,
