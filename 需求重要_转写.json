    {
      "start": 2760.48,
      "end": 2761.68,
      "text": "去去去做"
    },
    {
      "start": 2762.68,
      "end": 2763.88,
      "text": "现在都要求他们这样子"
    },
    {
      "start": 2768.58,
      "end": 2768.98,
      "text": "嗯"
    },
    {
      "start": 2769.18,
      "end": 2769.68,
      "text": "嗯"
    },
    {
      "start": 2770.28,
      "end": 2772.98,
      "text": "这样的办法他那边整个费用手部"
    },
    {
      "start": 2773.08,
      "end": 2774.38,
      "text": "就是每个频道多少钱"
    },
    {
      "start": 2774.38,
      "end": 2776.98,
      "text": "那个就在这无上找的那家"
    },
    {
      "start": 2777.28,
      "end": 2778.68,
      "text": "就是整个他能发全网嘛"
    },
    {
      "start": 2778.68,
      "end": 2779.08,
      "text": "啊"
    },
    {
      "start": 2779.08,
      "end": 2781.38,
      "text": "因为相对来说整个费用会低伸"
    },
    {
      "start": 2781.98,
      "end": 2782.38,
      "text": "不低"
    },
    {
      "start": 2782.48,
      "end": 2783.58,
      "text": "当地感到是个零钱"
    },
    {
      "start": 2783.78,
      "end": 2784.28,
      "text": "还行"
    },
    {
      "start": 2784.48,
      "end": 2786.48,
      "text": "人员人员方面是不是也"
    },
    {
      "start": 2787.48,
      "end": 2788.68,
      "text": "如果说那他们费用的话"
    },
    {
      "start": 2788.68,
      "end": 2790.18,
      "text": "他他如果说"
    },
    {
      "start": 2791.28,
      "end": 2793.08,
      "text": "如果我们的业务员能在当地找到"
    },
    {
      "start": 2793.08,
      "end": 2796.38,
      "text": "比比我们在外国公司地的人的话"
    },
    {
      "start": 2796.38,
      "end": 2797.38,
      "text": "是不是就事实"
    },
    {
      "start": 2797.68,
      "end": 2798.18,
      "text": "事实"
    },
    {
      "start": 2798.18,
      "end": 2800.18,
      "text": "是不是可以让他们自己安排的"
    },
    {
      "start": 2800.68,
