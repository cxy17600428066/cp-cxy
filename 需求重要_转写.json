      "end": 2871.08,
      "text": "每个人生里面活动"
    },
    {
      "start": 2871.08,
      "end": 2872.38,
      "text": "那个那那你啊"
    },
    {
      "start": 2872.38,
      "end": 2873.18,
      "text": "把活动拆到没了"
