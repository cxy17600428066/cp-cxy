      "start": 2893.18,
      "end": 2893.58,
      "text": "哎呦哎呦"
    },
    {
      "start": 2893.58,
      "end": 2894.78,
      "text": "我这里票怎么弄的"
    },
    {
      "start": 2895.18,
      "end": 2895.78,
      "text": "断了"
    },
    {
      "start": 2896.38,
      "end": 2898.08,
      "text": "他那个可以做你国营过平台"
