      "start": 2953.98,
      "end": 2954.78,
      "text": "应该也可以"
    },
    {
      "start": 2954.78,
      "end": 2956.68,
      "text": "但是他要开发票"
    },
    {
      "start": 2957.68,
      "end": 2958.68,
      "text": "他要开给我们开吗"
    },
