    {
      "start": 3108.88,
      "end": 3110.58,
      "text": "还是按照十万"
    },
    {
      "start": 3110.58,
      "end": 3111.88,
      "text": "他来时就算了"
    },
    {
      "start": 3112.38,
      "end": 3114.18,
      "text": "那收收了多少钱就算多少钱"
    },
    {
      "start": 3114.18,
      "end": 3114.78,
      "text": "还收吧"
